@article{schreiner_pesticide_2016,
	title = {Pesticide mixtures in streams of several European countries and the {USA}},
	volume = {573},
	issn = {0048-9697},
	url = {http://www.sciencedirect.com/science/article/pii/S0048969716318654},
	doi = {http://dx.doi.org/10.1016/j.scitotenv.2016.08.163},
	abstract = {Abstract Given the multitude of pesticides used in agriculture, adjacent streams are typically exposed to pesticide mixtures. Previous studies analysed the ecological risks of a few pesticide mixtures or were limited to an individual region or crop, whereas a large scale analysis of pesticide mixtures is missing. We analysed routine monitoring data from Germany, France, the Netherlands and the \{{USA}\} comprising a total of 4532 sites and 56,084 sampling occasions with the aim to identify the most frequently detected pesticides, their metabolites and mixtures. The most frequently detected compounds were dominated by herbicides and their metabolites. Mixtures mostly comprised of two up to five compounds, whereas mixtures in the \{{USA}\} and France had clearly less compounds than those of Germany and the Netherlands. The number of detected pesticides and thereby the size of mixtures is positively correlated to the number of measured pesticides (r = 0.57). In contrast, a low relationship was found to the ratio of agricultural areas within the catchment (r = 0.17), and no relationship was found to the size of the catchment (r = 0.06). Overall, our study provides priority mixtures for different countries that may be used for future ecotoxicological studies to improve risk assessment for stream ecosystems.},
	pages = {680 -- 689},
	journaltitle = {Science of The Total Environment},
	author = {Schreiner, Verena C. and Szöcs, Eduard and Bhowmik, Avit Kumar and Vijver, Martina G. and Schäfer, Ralf B.},
	date = {2016},
	keywords = {Data pre-processing},
	file = {mmc1.pdf:/Users/avitbhowmik/Library/Application Support/Zotero/Profiles/6zrmwrs4.default/zotero/storage/SSUR38RM/mmc1.pdf:application/pdf;Schreiner et al. - 2016 - Pesticide mixtures in streams of several European .pdf:/Users/avitbhowmik/Library/Application Support/Zotero/Profiles/6zrmwrs4.default/zotero/storage/57VWUWPM/Schreiner et al. - 2016 - Pesticide mixtures in streams of several European .pdf:application/pdf}
}

@report{schlosser_5_2016,
	location = {New York},
	title = {A 5 ̊C Arctic in a 2 ̊C World},
	rights = {report},
	url = {https://www.worldwildlife.org/press-releases/international-scientists-raise-red-flags-over-arctic-s-future},
	abstract = {The Columbia Climate Center, in partnership with World Wildlife Fund, Woods Hole Research Center, and Arctic 21, held a workshop titled A 5 ̊C Arctic in a 2 ̊C World on July 20 and 21, 2016. The workshop was co-sponsored by the International Arctic Research Center (University of Alaska Fairbanks), the Arctic Institute of North America (Canada), the {MEOPAR} Network (Marine Environmental Observation, Prediction, and Response), and the Future Ocean Excellence Cluster. The goal of the workshop was to advance thinking on the science and policy implications of the temperature change in the context of the 1.5 to {\textless}2 ̊C warming expected for the globe, as dis- cussed during the 21st session of the Conference of the Parties of the United Nations Framework Convention on Climate Change at Paris in 2015. For the Arctic, such an increase means an antic- ipated increase of roughly 3.5 to 5 ̊C. An international group of 41 experts shared perspectives on the regional and global impacts of an up to +5 ̊C Arctic, examined the feasibility of actively lowering Arctic temperatures, and considered realistic timescales associated with such interven- tions. The group also discussed the science and the political and governance actions required for alternative Arctic futures.},
	pages = {12},
	institution = {Columbia Climate Centre, Earth Institute, Columbia University; World Wildlife Fund; Arctic 21; Woods Hole Research Center},
	type = {Briefing Paper for Arctic Science Ministerial},
	author = {Schlosser, P. and Pfirman, S. and Pomerance, R. and Williams, M. and Ack, B. and Duffy, P. and Eicken, H. and Latif, M. and Murray, M. and Wallace, D. and Anderson, L. and Baker, B. and Bhowmik, A. and Bronen, R. and Ekwurzel, B. and Francis, J. and Gerlach, C. and Horton, R. and Karcher, M. and Kelly, B. and Kelly, C. and Kim, S. and Levermann, A. and Metcalf, V. and Mueter, F. and Newton, B. and Park, A. and Pasztor, J. and Rasch, P. and Romanovsky, V. and Shaw, R. and Stephenson, S. and Tilmes, S. and Titley, D. and Tremblay, B. and Vorosmarty, C.},
	urldate = {2016-09-30},
	date = {2016},
	file = {5C_Arctic_2pager_final.pdf:/Users/avitbhowmik/Library/Application Support/Zotero/Profiles/6zrmwrs4.default/zotero/storage/4SFNN2UD/5C_Arctic_2pager_final.pdf:application/pdf;5C-Arctic-paper (3).pdf:/Users/avitbhowmik/Library/Application Support/Zotero/Profiles/6zrmwrs4.default/zotero/storage/PUMZX7V2/5C-Arctic-paper (3).pdf:application/pdf}
